{
    "name": "moselwal/fa4t3",
    "description": "Fathom Analytics integration for TYPO3 CMS — Backend Dashboard, Page Analytics, Frontend Tracking.",
    "license": "MIT",
    "type": "typo3-cms-extension",
    "keywords": [
        "analytics",
        "dashboard",
        "fa4t3",
        "fathom",
        "privacy",
        "typo3"
    ],
    "authors": [
        {
            "name": "Moselwal Digitalagentur GmbH",
            "email": "support@moselwal.de",
            "homepage": "https://moselwal.de",
            "role": "Maintainer"
        },
        {
            "name": "Kai Ole Hartwig",
            "email": "o.hartwig@moselwal.de",
            "role": "Developer"
        }
    ],
    "homepage": "https://moselwal.de",
    "support": {
        "issues": "https://github.com/Moselwal-Digitalagentur/fa4t3/issues",
        "source": "https://github.com/Moselwal-Digitalagentur/fa4t3",
        "docs": "https://moselwal.de/open-source/fa4t3"
    },
    "require": {
        "php": "^8.5",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "typo3/cms-backend": "^14.0",
        "typo3/cms-core": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-fluid": "^14.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "moselwal/dev": "^5.2"
    },
    "suggest": {
        "moselwal/secret-resolver": "Secure resolution of API key and password from encrypted secrets (SOPS, Vault, etc.)"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/175/-/packages/composer/packages.json",
            "only": [
                "moselwal/*",
                "hn/typo3-mcp-server",
                "netresearch/nr-passkeys-be"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Moselwal\\FA4T3\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moselwal\\FA4T3\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "fa4t3"
        },
        "unused": [
            "typo3/cms-fluid"
        ]
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "test": "phpunit -c Tests/phpunit.xml"
    }
}